<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Uygulama hiçbir veri toplamıyor: hesap, e-posta, sunucu ve ağ isteği yok.
	  Her şey cihazda localStorage'da kalıyor.

	  Önceki hâli e-posta, kullanıcı kimliği ve kullanıcı içeriği topladığını
	  beyan ediyordu — Supabase döneminden kalmaydı. Apple bu manifesti App
	  Store Connect'teki gizlilik cevaplarıyla karşılaştırdığı için, toplanmayan
	  veriyi beyan etmek hem yanlış hem de incelemede tutarsızlık yaratırdı.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Tercihler ve çalışma geçmişi cihazda saklanıyor.
			     CA92.1 = yalnızca uygulamanın kendi verisi için kullanım. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
