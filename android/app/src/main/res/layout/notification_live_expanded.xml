<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded big view — RemoteViews uyumlu (sadece FrameLayout/LinearLayout/GridLayout) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A1228"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Üst bölüm: sol emoji+etiket | sağ timer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Sol: emoji -->
        <TextView
            android:id="@+id/icon_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏊"
            android:textSize="36sp" />

        <!-- Orta: etiketler -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/mode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Çalışıyor"
                android:textColor="#E2E8F0"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/swim_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="≋ SWIM"
                android:textColor="#2DD4BF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Sağ: büyük timer -->
        <Chronometer
            android:id="@+id/chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2DD4BF"
            android:textSize="46sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:visibility="visible" />

        <TextView
            android:id="@+id/timer_static"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8899AA"
            android:textSize="46sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Ayırıcı çizgi -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="#162040" />

    <!-- Progress bar + yüzde -->
    <LinearLayout
        android:id="@+id/progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:progressBackgroundTint="#162040"
            android:progressTint="#2DD4BF"
            android:max="1000"
            android:progress="0"
            android:visibility="visible" />

        <TextView
            android:id="@+id/pct_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="0%"
            android:textColor="#4A6888"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Gizli (uyumluluk) -->
    <TextView
        android:id="@+id/finished_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
