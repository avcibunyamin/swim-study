rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanicilar - okuma herkese acik (kayit sirasinda kullanici adi kontrolu icin)
    // Yazma islemleri icin kimlik dogrulamasi gerekli
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Kendi belgesini tamamen guncelleyebilir
      allow update: if request.auth != null && request.auth.uid == userId;

      // Diger kullanicilar sadece arkadaslik/oda alanlarini guncelleyebilir
      allow update: if request.auth != null
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['friends', 'friendRequests', 'sentRequests', 'currentRoom', 'roomMemberCount', 'roomIsRunning', 'isWorking']);
    }

    // 1-1 Sohbetler - sadece chat'e dahil olan kullanicilar
    match /chats/{chatId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in chatId.split('_');
    }

    // Calisma odalari - sadece oda uyeleri degistirebilir
    match /studyRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid;
    }

    // Oda mesajlari - sadece oda uyeleri okuyabilir ve yazabilir
    match /studyRooms/{roomId}/messages/{msgId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/studyRooms/$(roomId))
        && request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.members;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text.size() <= 1000
        && exists(/databases/$(database)/documents/studyRooms/$(roomId))
        && request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.members;
      allow delete: if request.auth != null
        && resource.data.senderId == request.auth.uid;
    }

    // Calisma davetleri - sadece ilgili kullanicilar okuyabilir ve islem yapabilir
    match /studyInvites/{inviteId} {
      allow read: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow delete: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
    }
  }
}
